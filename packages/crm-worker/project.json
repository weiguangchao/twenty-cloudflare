{
  "name": "crm-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/crm-worker/src",
  "projectType": "application",
  "tags": ["scope:backend"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build", "crm-front:build"],
      "options": {
        "cwd": "packages/crm-worker",
        "command": "wrangler dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "crm-front:build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/crm-worker",
        "command": "wrangler deploy --dry-run --outdir dist"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/crm-worker",
        "command": "node scripts/deploy.mjs production"
      }
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "config": "{projectRoot}/vitest.config.ts"
      }
    },
    "provision": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "packages/crm-worker",
        "command": "node scripts/provision.mjs production"
      }
    }
  }
}
