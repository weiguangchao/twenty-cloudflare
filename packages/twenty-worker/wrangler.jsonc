{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "twenty-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "alias": {
    "twenty-shared/application": "../twenty-shared/src/application/index.ts",
    "twenty-shared/utils": "../twenty-shared/src/utils/index.ts",
    "twenty-shared/types": "../twenty-shared/src/types/index.ts",
    "twenty-shared/constants": "../twenty-shared/src/constants/index.ts",
    "twenty-shared/metadata": "../twenty-shared/src/metadata/index.ts",
    "twenty-shared/translations": "../twenty-shared/src/translations/index.ts",
    "twenty-shared/workflow": "../twenty-shared/src/workflow/index.ts",
    "twenty-shared/composite-type-definitions": "../twenty-shared/dist/types.mjs",
  },
  "secrets": {
    "required": ["APP_SECRET"],
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.graphql"],
      "fallthrough": true,
    },
  ],
  "assets": {
    "directory": "../twenty-front/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/admin-panel",
      "/admin-panel/*",
      "/app",
      "/app/*",
      "/application-registration-claim",
      "/application-registration-claim/*",
      "/apps",
      "/apps/*",
      "/auth",
      "/auth/*",
      "/client-config",
      "/client-config/*",
      "/cloudflare",
      "/cloudflare/*",
      "/emailing",
      "/emailing/*",
      "/file",
      "/file/*",
      "/file-upload",
      "/file-upload/*",
      "/files",
      "/files/*",
      "/graphql",
      "/graphql/*",
      "/healthz",
      "/healthz/*",
      "/mcp",
      "/mcp/*",
      "/metadata",
      "/metadata/*",
      "/oauth",
      "/oauth/*",
      "/open-api",
      "/open-api/*",
      "/public-assets",
      "/public-assets/*",
      "/rest",
      "/rest/*",
      "/s",
      "/s/*",
      "/webhooks",
      "/webhooks/*",
      "/.well-known",
      "/.well-known/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "twenty-core",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "twenty-files",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "twenty-jobs",
        "max_batch_size": 10,
        "max_retries": 5,
      },
    ],
    "producers": [
      {
        "binding": "JOBS",
        "queue": "twenty-jobs",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "WorkspaceDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDurableObject"],
    },
  ],
  "dev": {
    "port": 3000,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "workers_dev": true,
  "vars": {
    "MAINTENANCE_MODE": "false",
  },
  "env": {
    "dev": {
      "name": "twenty-crm-dev",
      "workers_dev": true,
      "vars": {
        "MAINTENANCE_MODE": "false",
      },
      "d1_databases": [
        {
          "binding": "CORE_DB",
          "database_name": "twenty-core-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "twenty-files-dev",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "twenty-jobs-dev",
          },
        ],
        "consumers": [
          {
            "queue": "twenty-jobs-dev",
            "max_batch_size": 10,
            "max_retries": 5,
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORKSPACE",
            "class_name": "WorkspaceDurableObject",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
      "send_email": [],
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "secrets": {
        "required": ["APP_SECRET"],
      },
    },
    "production": {
      "name": "twenty-crm-production",
      "workers_dev": true,
      "vars": {
        "MAINTENANCE_MODE": "false",
      },
      "d1_databases": [
        {
          "binding": "CORE_DB",
          "database_name": "twenty-core-production",
          "database_id": "d6205d72-a77a-4565-848c-d4402aa1cf0d",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "twenty-files-production",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "twenty-jobs-production",
          },
        ],
        "consumers": [
          {
            "queue": "twenty-jobs-production",
            "max_batch_size": 10,
            "max_retries": 5,
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORKSPACE",
            "class_name": "WorkspaceDurableObject",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
      "send_email": [],
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "secrets": {
        "required": ["APP_SECRET"],
      },
    },
  },
}
