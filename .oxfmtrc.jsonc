{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/lib/**",
    "**/.next/**",
    "**/coverage/**",
    "**/generated/**",
    "**/generated-metadata/**",
    "**/.cache/**",
    "**/node_modules/**",
    "**/*.min.js",
    "**/*.snap",
    "**/*.md",
    "**/*.mdx",
    "packages/crm-worker/contract/fixtures/**",
    "packages/crm-worker/contract/metadata-export/**",
    "packages/crm-worker/contract/*.graphql",
    "packages/crm-worker/src/workspace/seed/*.json",
    "packages/crm-worker/worker-configuration.d.ts",
  ],
}
